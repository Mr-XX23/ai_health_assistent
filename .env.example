# ============================================================================
# Frontend Environment Variables - EXAMPLE
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control
# ============================================================================

# API Base URL
# Development: http://localhost:8080/api/v1
# Production: https://api.medisecure.com/api/v1
VITE_BASE_URL=http://localhost:8080/api/v1

# AI Physician Service URL
# Development: http://localhost:8005
# Production: https://ai-physician.medisecure.com
VITE_AI_PHYSICIAN_URL=http://localhost:8005

# API Request Timeout (milliseconds)
# Default: 10000 (10 seconds)
# Increase for slow networks or large file uploads
VITE_API_TIMEOUT=10000

# Environment
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_ANALYTICS=false

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never store sensitive credentials in frontend environment variables
# 2. All VITE_ prefixed variables are exposed to the browser
# 3. Backend API keys should NEVER be in frontend .env
# 4. Use different values for development/staging/production
# ============================================================================
